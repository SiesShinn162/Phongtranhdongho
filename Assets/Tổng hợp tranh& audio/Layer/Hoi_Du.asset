  m_Name: Hoi_Du
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tranh D\xE2n Gian \u0110\xF4ng H\u1ED3 H\u1ED9i \u0110u"
  moTa: "Tranh H\u1ED9i \u0110u thu\u1ED9c th\u1EC3 lo\u1EA1i tranh phong t\u1EE5c
    trong Ngh\u1EC7 thu\u1EADt tranh D\xE2n gian \u0110\xF4ng H\u1ED3, mang \u0111\u1EBFn
    h\xECnh \u1EA3nh sinh \u0111\u1ED9ng v\u1EC1 tr\xF2 ch\u01A1i truy\u1EC1n th\u1ED1ng
    c\u1EE7a ng\u01B0\u1EDDi d\xE2n Vi\u1EC7t Nam trong qu\xE1 kh\u1EE9 v\xE0 v\u1EABn
    \u0111\u01B0\u1EE3c duy tr\xEC t\u1EA1i m\u1ED9t s\u1ED1 l\xE0ng qu\xEA ng\xE0y
    nay.\r\n\r\nTr\xF2 ch\u01A1i \u0110\xE1nh \u0110u: Tr\xF2 ch\u01A1i \u0111\xE1nh
    \u0111u th\u01B0\u1EDDng di\u1EC5n ra v\xE0o nh\u1EEFng ng\xE0y T\u1EBFt c\u1ED5
    truy\u1EC1n ho\u1EB7c c\xE1c l\u1EC5 h\u1ED9i \u0111\u1EA7u xu\xE2n t\u1EA1i
    c\xE1c h\u1ED9i l\xE0ng. C\u1EA3 l\xE0ng h\u0103ng h\xE1i ch\u1ECDn c\xE2y tre
    \u0111\u1EB9p \u0111\u1EC3 d\u1EF1ng c\u1ED9t \u0111u, th\u01B0\u1EDDng \u0111\u01B0\u1EE3c
    \u0111\u1EB7t gi\u1EEFa s\xE2n \u0111\xECnh l\xE0ng. C\xE2y \u0111u bao g\u1ED3m
    tr\u1EE5 \u0111u, th\u01B0\u1EE3ng \u0111u, tay \u0111u v\xE0 b\xE0n \u0111u,
    t\u1EA1o n\xEAn kh\xF4ng gian vui t\u01B0\u01A1i v\xE0 h\u1EE9ng kh\u1EDFi."
  anhTranh: {fileID: 21300000, guid: f575d95e7577c1f449972020aa2eb8f5, type: 3}
  amThanhThuyetMinh: {fileID: 0}

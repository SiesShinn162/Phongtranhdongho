  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tranh D\xE2n Gian \u0110\xF4ng H\u1ED3 Vinh Quy B\xE1i T\u1ED5"
  moTa: "Tranh \u0110\xF4ng H\u1ED3 \"Vinh Quy B\xE1i T\u1ED5\" l\xE0 m\u1ED9t trong
    nh\u1EEFng t\xE1c ph\u1EA9m ti\xEAu bi\u1EC3u c\u1EE7a d\xF2ng tranh d\xE2n gian
    \u0110\xF4ng H\u1ED3, c\xF3 ngu\u1ED3n g\u1ED1c t\u1EEB l\xE0ng \u0110\xF4ng
    H\u1ED3, t\u1EC9nh B\u1EAFc Ninh \u2013 c\xE1i n\xF4i c\u1EE7a ngh\u1EC7 thu\u1EADt
    tranh d\xE2n gian Vi\u1EC7t Nam. \u0110\xE2y l\xE0 b\u1EE9c tranh mang \u0111\u1EADm
    t\xEDnh l\u1ECBch s\u1EED v\xE0 nh\xE2n v\u0103n, th\u1EC3 hi\u1EC7n \u0111\u1EA1o
    l\xFD truy\u1EC1n th\u1ED1ng \"C\xF4ng cha, ngh\u0129a m\u1EB9, \u01A1n th\u1EA7y\"
    \u2013 m\u1ED9t trong nh\u1EEFng gi\xE1 tr\u1ECB c\u1ED1t l\xF5i trong v\u0103n
    h\xF3a Vi\u1EC7t."
  anhTranh: {fileID: 21300000, guid: fca4cd1244a8bf843831558cf68239a0, type: 3}
  amThanhThuyetMinh: {fileID: 0}

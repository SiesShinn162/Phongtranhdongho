  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Ti\u1EBFn_L\u1ED9c"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Ti\u1EBFn L\u1ED9c"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t v\u1ECB th\u1EA7n
    uy nghi\xEAm, m\u1ED9t tay n\xE2ng cu\u1ED1n th\u01B0 t\u01B0\u1EE3ng tr\u01B0ng
    cho s\u1EF1 hi\u1EBFu h\u1ECDc v\xE0 h\u1ECDc v\u1EA5n, tay kia c\u1EA7m g\u1EADy
    nh\u01B0 \xFD bi\u1EC3u tr\u01B0ng cho quy\u1EC1n l\u1EF1c, \u0111\u1ECBa v\u1ECB
    c\xF9ng kh\u1EA3 n\u0103ng v\u1EA1n s\u1EF1 nh\u01B0 \xFD. Tr\xEAn tranh kh\u1EAFc
    b\u1ED1n ch\u1EEF ch\u1EEF H\xE1n ho\u1EB7c ch\u1EEF N\xF4m \"L\u1ED9c V\u1ECB
    Cao Th\u0103ng\" mang \xFD ngh\u0129a c\u1EA7u ch\xFAc b\u1ED5ng l\u1ED9c, ch\u1EE9c
    t\u01B0\u1EDBc ng\xE0y c\xE0ng t\u0103ng ti\u1EBFn, r\u1ED9ng m\u1EDF. T\xE1c
    ph\u1EA9m g\u1EEDi g\u1EAFm mong \u01B0\u1EDBc s\xE2u s\u1EAFc c\u1EE7a ng\u01B0\u1EDDi
    x\u01B0a v\u1EC1 s\u1EF1 th\xE0nh \u0111\u1EA1t, c\xF4ng th\xE0nh danh to\u1EA1i,
    th\u0103ng quan ti\u1EBFn ch\u1EE9c v\xE0 \u0111\xF3n nh\u1EADn nhi\u1EC1u may
    m\u1EAFn trong cu\u1ED9c s\u1ED1ng."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: " Xu\u1EA5t x\u1EE9: T\u1EEB l\xE0ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3
    (Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh), m\xF4 t\u1EA3 v\u1ECB th\u1EA7n tay c\u1EA7m
    g\u1EADy nh\u01B0 \xFD, d\xF2ng ch\u1EEF tr\xEAn g\xF3c tranh ghi \"L\u1ED9c
    v\u1ECB cao th\u0103ng\".\n \xDD ngh\u0129a: C\u1EA7u ch\xFAc c\xF4ng danh th\u0103ng
    ti\u1EBFn, b\u1ED5ng l\u1ED9c d\u1ED3i d\xE0o, \u0111\u1ECBa v\u1ECB ng\xE0y
    c\xE0ng cao v\xE0 m\u1ECDi s\u1EF1 hanh th\xF4ng, nh\u01B0 \xFD."
  anhTranh: {fileID: 21300000, guid: af4bb5e361954f549aaf1b6c32357422, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: a193d99f81bbd434f91988e29ecb0008, type: 3}

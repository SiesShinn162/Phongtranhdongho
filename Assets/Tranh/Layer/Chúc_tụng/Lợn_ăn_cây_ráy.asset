  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "L\u1EE3n_\u0103n_c\xE2y_r\xE1y"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "L\u1EE3n \u0102n C\xE2y R\xE1y"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t ch\xFA l\u1EE3n
    b\xE9o t\u1ED1t, kh\u1ECFe m\u1EA1nh b\xEAn kh\xF3m c\xE2y r\xE1y, tr\xEAn m\xECnh
    mang nh\u1EEFng xo\xE1y \xE2m d\u01B0\u01A1ng \u0111\u1EB7c tr\u01B0ng. Con l\u1EE3n
    trong \u0111\u1EDDi s\u1ED1ng n\xF4ng nghi\u1EC7p l\xE0 bi\u1EC3u t\u01B0\u1EE3ng
    c\u1EE7a s\u1EF1 no \u0111\u1EE7, an nh\xE0n v\xE0 sinh s\xF4i n\u1EA3y n\u1EDF.
    H\xECnh \u1EA3nh ch\xFA l\u1EE3n \u0103n c\xE2y r\xE1y \u2013 m\u1ED9t lo\u1EA1i
    c\xE2y hoang d\u1EA1i, d\u1EC5 s\u1ED1ng \u2013 th\u1EC3 hi\u1EC7n c\xE1i nh\xECn
    l\u1EA1c quan c\u1EE7a ng\u01B0\u1EDDi n\xF4ng d\xE2n v\u1EC1 cu\u1ED9c s\u1ED1ng
    t\u1EF1 t\u1EA1i, c\xF3 s\u1EE9c s\u1ED1ng m\xE3nh li\u1EC7t, \u0111\u1ED3ng
    th\u1EDDi l\xE0 l\u1EDDi ch\xFAc cho gia \u0111\u1EA1o lu\xF4n sung t\xFAc, ph\xE1t
    t\xE0i, ph\xE1t l\u1ED9c v\xE0 v\u1EA1n s\u1EF1 nh\u01B0 \xFD."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "B\u1EE9c tranh \u0110\xF4ng H\u1ED3 L\u1EE3n \u0102n C\xE2y R\xE1y  treo
    t\u01B0\u1EDDng c\xF3 nhi\u1EC1u \xFD ngh\u0129a v\xE0 th\xF4ng \u0111i\u1EC7p
    \u0111\u01B0\u1EE3c truy\u1EC1n t\u1EA3i:\r\n\r\n\xDD ngh\u0129a v\u1EC1 s\u1EF1
    gi\xE0u c\xF3 v\xE0 sung t\xFAc: H\xECnh \u1EA3nh ch\xFA l\u1EE3n \u0111\u1ED3
    s\u1ED9, m\u0169m m\u0129m th\u1EC3 hi\u1EC7n mong mu\u1ED1n v\u1EC1 s\u1EF1
    phong ph\xFA, \u0111\u1EA7y \u0111\u1EE7 t\xE0i l\u1ED9c v\xE0 thu\u1EADn l\u1EE3i
    trong cu\u1ED9c s\u1ED1ng.\r\n\r\n\xDD ngh\u0129a v\u1EC1 s\u1EF1 ph\xE1t tri\u1EC3n
    v\xE0 th\u1ECBnh v\u01B0\u1EE3ng: C\xE1i l\u01B0ng v\xF5ng b\u1EE5ng sa v\xE0
    vi\u1EC1n \u0111ai m\xE0u kh\xE1c tr\xEAn l\u01B0ng l\u1EE3n bi\u1EC3u th\u1ECB
    s\u1EF1 ph\xE1t tri\u1EC3n t\u1ED1t, s\u1EF1 th\xE0nh c\xF4ng trong c\xF4ng vi\u1EC7c
    v\xE0 s\u1EF1 \u0103n ch\xF3ng l\u1EDBn."
  anhTranh: {fileID: 21300000, guid: 1141464eb1e3d784bb097df92e8a4058, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: e26efb66953e68244b1508cb70e54e53, type: 3}

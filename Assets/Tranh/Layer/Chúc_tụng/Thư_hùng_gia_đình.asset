  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Th\u01B0_h\xF9ng_gia_\u0111\xECnh"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Th\u01B0 H\xF9ng"
  yNghia: "B\u1EE9c tranh mi\xEAu t\u1EA3 tr\u1ECDn v\u1EB9n m\u1ED9t gia \u0111\xECnh
    g\xE0 g\u1ED3m g\xE0 tr\u1ED1ng, g\xE0 m\xE1i v\xE0 \u0111\xE0n con th\u01A1
    qu\xE2y qu\u1EA7n \u0111\u1EA7m \u1EA5m. H\xECnh d\xE1ng g\xE0 tr\u1ED1ng m\u1EA1nh
    m\u1EBD ch\u1EDF che, k\u1EBFt h\u1EE3p c\xF9ng b\u1ED1 c\u1EE5c g\xE0 m\xE1i
    m\u1EC1m m\u1EA1i v\xE0 d\xF2ng ch\u1EEF N\xF4m \"L\u1EAFm con nhi\u1EC1u ch\xE1u,
    gi\u1ED1ng c\xE1nh gi\u1ED1ng l\xF4ng\" bi\u1EC3u tr\u01B0ng s\xE2u s\u1EAFc
    cho t\xECnh y\xEAu th\u01B0\u01A1ng, s\u1EF1 h\xF2a thu\u1EADn. B\u1EE9c tranh
    g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc n\u0103m m\u1EDBi gia \u0111\xECnh lu\xF4n
    \u0111o\xE0n vi\xEAn, g\u1EAFn k\u1EBFt b\u1EC1n ch\u1EB7t, con ch\xE1u th\u1EA3o
    hi\u1EC1n v\xE0 cu\u1ED9c s\u1ED1ng th\u1ECBnh v\u01B0\u1EE3ng, \u0111\u1EA7y
    \u1EAFp ti\u1EBFng c\u01B0\u1EDDi."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "G\xE0 tr\u1ED1ng oai v\u1EC7 c\xF9ng g\xE0 m\xE1i v\xE0 \u0111\xE0n g\xE0
    con qu\xE2y qu\u1EA7n b\xEAn nhau t\u01B0\u1EE3ng tr\u01B0ng cho gia \u0111\xECnh
    sum v\u1EA7y, con ch\xE1u \u0111\u1EC1 hu\u1EC1, cu\u1ED9c s\u1ED1ng no \u0111\u1EE7.
    Tranh c\xF2n g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc h\xF2a thu\u1EADn, sinh s\xF4i
    v\xE0 m\u1ED9t n\u0103m l\xE0m \u0103n thu\u1EADn l\u1EE3i."
  anhTranh: {fileID: 21300000, guid: 32d3b83d89e5b644787ce69705dd7ce3, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: af716e82343b4a44ebdeeea11d63e12a, type: 3}

  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "\u0110inh_t\xE0i_t\u01B0\u01A1ng_vu\u1ECDng"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "\u0110inh T\xE0i T\u01B0\u01A1ng V\u01B0\u1EE3ng"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh hai \u0111\u1EE9a tr\u1EBB
    b\u1EE5 b\u1EABm, \u0111\u1EE9a l\u1EDBn \u0111ang \u1EB5m b\u1ED3ng \u0111\u1EE9a
    nh\u1ECF che ch\u1EDF, tr\xEAn tay c\u1EA7m cu\u1ED1n s\xE1ch c\xF3 \u0111\u1EC1
    ch\u1EEF ch\u1EEF H\xE1n \"\u0110inh T\xE0i T\u01B0\u01A1ng V\u01B0\u1EE3ng\"
    (\u4E01\u8CA1\u76F8\u65FA) mang \xFD ngh\u0129a c\u1EA7u ch\xFAc cho gia \u0111\xECnh
    s\u1EDBm sinh qu\xFD t\u1EED, l\u1EAFm con nhi\u1EC1u ch\xE1u v\xE0 gia \u0111\u1EA1o
    h\u01B0ng th\u1ECBnh. B\xEAn c\u1EA1nh hai \u0111\u1EE9a tr\u1EBB l\xE0 m\u1ED9t
    chi\u1EBFc h\u0169 l\u1EDBn kh\u1EAFc ch\u1EEF \"Kim\" (\u91D1 - v\xE0ng b\u1EA1c),
    bi\u1EC3u tr\u01B0ng cho s\u1EF1 sung t\xFAc, ph\xFA qu\xFD, c\u1EE7a \u0103n
    c\u1EE7a \u0111\u1EC3. T\xE1c ph\u1EA9m l\xE0 l\u1EDDi ch\xFAc n\u0103m m\u1EDBi
    tr\u1ECDn v\u1EB9n v\u1EC1 \u0111\u01B0\u1EDDng con c\xE1i l\u1EABn ti\u1EC1n
    t\xE0i v\u1EADt ch\u1EA5t, \u0111\u1ED3ng th\u1EDDi \u0111\u1EC1 cao t\xECnh
    c\u1EA3m anh em h\xF2a thu\u1EADn, g\u1EAFn b\xF3 keo s\u01A1n v\xE0 tinh th\u1EA7n
    hi\u1EBFu h\u1ECDc trong gia \u0111\xECnh."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: " Xu\u1EA5t x\u1EE9: T\u1EEB l\xE0ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3
    (Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh), tr\xEAn b\u1EE9c tranh kh\u1EAFc d\xF2ng
    ch\u1EEF H\xE1n \"\u4E01\u8CA1\u76F8\u65FA\" (\u0110inh T\xE0i T\u01B0\u1EDBng
    V\u01B0\u1EE3ng) v\xE0 chi\u1EBFc b\xECnh c\xF3 kh\u1EAFc ch\u1EEF \"\u91D1\"
    (Kim).\n \xDD ngh\u0129a: L\u1EDDi ch\xFAc ph\xFAc tr\u1ECDn v\u1EB9n v\u1EC1
    \"l\u1EAFm con nhi\u1EC1u ch\xE1u v\xE0 gi\xE0u sang\" (\"\u0110inh\" ch\u1EE7
    v\u1EC1 nh\xE2n \u0111inh, con trai n\u1ED1i d\xF5i; \"T\xE0i\" ch\u1EE7 v\u1EC1
    t\xE0i l\u1ED9c, c\u1EE7a c\u1EA3i); c\u1EA7u mong gia \u0111\u1EA1o h\u01B0ng
    th\u1ECBnh, con ch\xE1u ch\u0103m ngoan, hi\u1EBFu h\u1ECDc v\xE0 \u0111\u1ED7
    \u0111\u1EA1t h\u1EF1u h\u1EF7."
  anhTranh: {fileID: 21300000, guid: ee543fad7ddde7044971f54159868051, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 16d50b54d9f9383449386cd1ff8b89db, type: 3}

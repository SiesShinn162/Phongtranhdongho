  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "\u0110inh_t\xE0i_t\u01B0\u01A1ng_vu\u1ECDng"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tranh d\xE2n gian \u0110\xF4ng H\u1ED3 \u0110inh T\xE0i T\u01B0\u01A1ng
    V\u01B0\u1EE3ng"
  moTa: " Xu\u1EA5t x\u1EE9: T\u1EEB l\xE0ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3
    (Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh), tr\xEAn b\u1EE9c tranh kh\u1EAFc d\xF2ng
    ch\u1EEF H\xE1n \"\u4E01\u8CA1\u76F8\u65FA\" (\u0110inh T\xE0i T\u01B0\u1EDBng
    V\u01B0\u1EE3ng) v\xE0 chi\u1EBFc b\xECnh c\xF3 kh\u1EAFc ch\u1EEF \"\u91D1\"
    (Kim).\n \xDD ngh\u0129a: L\u1EDDi ch\xFAc ph\xFAc tr\u1ECDn v\u1EB9n v\u1EC1
    \"l\u1EAFm con nhi\u1EC1u ch\xE1u v\xE0 gi\xE0u sang\" (\"\u0110inh\" ch\u1EE7
    v\u1EC1 nh\xE2n \u0111inh, con trai n\u1ED1i d\xF5i; \"T\xE0i\" ch\u1EE7 v\u1EC1
    t\xE0i l\u1ED9c, c\u1EE7a c\u1EA3i); c\u1EA7u mong gia \u0111\u1EA1o h\u01B0ng
    th\u1ECBnh, con ch\xE1u ch\u0103m ngoan, hi\u1EBFu h\u1ECDc v\xE0 \u0111\u1ED7
    \u0111\u1EA1t h\u1EF1u h\u1EF7."
  anhTranh: {fileID: 21300000, guid: ee543fad7ddde7044971f54159868051, type: 3}
  amThanhThuyetMinh: {fileID: 0}

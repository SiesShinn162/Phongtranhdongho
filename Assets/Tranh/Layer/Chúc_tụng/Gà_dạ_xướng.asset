  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "G\xE0_d\u1EA1_x\u01B0\u1EDBng"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "G\xE0 D\u1EA1 X\u01B0\u1EDBng"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t ch\xFA g\xE0
    tr\u1ED1ng uy nghi \u0111ang c\u1EA5t ti\u1EBFng g\xE1y vang trong \u0111\xEAm,
    b\xEAn tr\xEAn c\xF3 d\xF2ng ch\u1EEF ch\u1EEF N\xF4m \"D\u1EA1 x\u01B0\u1EDBng
    ng\u0169 canh k\xEA\" (\u0110\xEAm g\xE1y n\u0103m canh). Ti\u1EBFng g\xE0 d\u1EA1
    x\u01B0\u1EDBng bi\u1EC3u tr\u01B0ng cho s\u1EF1 th\u1EE9c t\u1EC9nh, b\xE1o
    hi\u1EC7u b\xECnh minh s\u1EAFp \u0111\u1EBFn v\xE0 xua tan \u0111i m\xE0n \u0111\xEAm
    t\u0103m t\u1ED1i c\xF9ng t\xE0 ma, qu\u1EF7 d\u1EEF. B\u1EE9c tranh g\u1EEDi
    g\u1EAFm l\u1EDDi ch\xFAc cho gia ch\u1EE7 lu\xF4n gi\u1EEF \u0111\u01B0\u1EE3c
    s\u1EF1 t\u1EC9nh t\xE1o, n\u1EC1 n\u1EBFp, \u0111\xFAng gi\u1EDD gi\u1EA5c,
    \u0111\u1ED3ng th\u1EDDi mang l\u1EA1i s\u1EF1 may m\u1EAFn, b\xECnh an v\xE0
    h\u1ED9 m\u1EC7nh cho c\u1EA3 gia \u0111\xECnh."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "Trong kho t\xE0ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u201CG\xE0 D\u1EA1
    X\u01B0\u1EDBng\u201D n\u1ED5i b\u1EADt nh\u01B0 m\u1ED9t kh\xFAc tr\xE1ng ca
    r\u1EF1c r\u1EE1 s\u1EAFc m\xE0u v\xE0 \u0111\u1EA7y s\u1EE9c s\u1ED1ng, th\u1EC3
    hi\u1EC7n tinh th\u1EA7n m\u1EA1nh m\u1EBD, \u0111\u1ED9c l\u1EADp v\xE0 ki\xEAn
    c\u01B0\u1EDDng \u2013 nh\u1EEFng ph\u1EA9m ch\u1EA5t \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi
    x\u01B0a g\u1EEDi g\u1EAFm qua h\xECnh t\u01B0\u1EE3ng ch\xFA g\xE0 tr\u1ED1ng
    oai v\u1EC7."
  anhTranh: {fileID: 21300000, guid: 41707bea5e9b22b428035402e3ea01f1, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 241e313442903974f86865bed805c9c9, type: 3}

  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "\u0110\xE0n_l\u1EE3n_\xE2m_d\u01B0\u01A1ng"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "\u0110\xE0n l\u1EE3n \xC2m D\u01B0\u01A1ng"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t con l\u1EE3n
    m\u1EB9 b\xE9o kh\u1ECFe \u0111ang qu\xE2y qu\u1EA7n b\xEAn \u0111\xE0n l\u1EE3n
    con, tr\xEAn m\xECnh m\u1ED7i con \u0111\u1EC1u mang nh\u1EEFng xo\xE1y \xE2m
    d\u01B0\u01A1ng t\u01B0\u1EE3ng tr\u01B0ng cho s\u1EF1 h\xE0i h\xF2a c\u1EE7a
    \u0111\u1EA5t tr\u1EDDi v\xE0 quy lu\u1EADt sinh h\xF3a c\u1EE7a v\u0169 tr\u1EE5.
    Trong v\u0103n h\xF3a n\xF4ng nghi\u1EC7p, h\xECnh \u1EA3nh n\xE0y bi\u1EC3u
    tr\u01B0ng cho s\u1EF1 sinh s\xF4i n\u1EA3y n\u1EDF, \"con \u0111\xE0n ch\xE1u
    \u0111\u1ED1ng\" v\xE0 cu\u1ED9c s\u1ED1ng \u1EA5m no, d\u01B0 d\u1EA3. B\u1EE9c
    tranh g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc cho gia \u0111\xECnh lu\xF4n h\xF2a
    thu\u1EADn, sung t\xFAc, kinh doanh ph\xE1t \u0111\u1EA1t v\xE0 ch\u0103n nu\xF4i
    g\u1EB7p nhi\u1EC1u thu\u1EADn l\u1EE3i, may m\u1EAFn."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "B\u1EE9c tranh \u0110\xF4ng H\u1ED3 l\u1EE3n \u0111\xE0n t\u01B0\u1EE3ng
    tr\u01B0ng cho s\u1EF1 sinh s\xF4i, n\u1EA3y n\u1EDF, \u1EA5m no v\xE0 ph\xE1t
    tri\u1EC3n trong t\xEDn ng\u01B0\u1EE1ng d\xE2n gian. Trong n\xF4ng th\xF4n Vi\u1EC7t
    Nam, nu\xF4i heo l\xE0 m\u1ED9t ph\u01B0\u01A1ng th\u1EE9c m\u01B0u sinh, thu
    th\u1EADp s\u1EA3n ph\u1EA9m d\u01B0 th\u1EEBa \u0111\u1EC3 t\xEDch g\xF3p ti\u1EC1n
    l\u1EDBn, cung c\u1EA5p ph\xE2n b\xF3n h\u1EEFu c\u01A1 v\xE0 cung c\u1EA5p th\u1ECBt
    cho gia \u0111\xECnh. H\xECnh \u1EA3nh \u0111\xE0n l\u1EE3n kh\u1ECFe m\u1EA1nh
    th\u1EC3 hi\u1EC7n \u01B0\u1EDBc mu\u1ED1n v\u1EC1 s\u1EF1 ph\u1ED3n th\u1ECBnh,
    t\u0103ng gia s\u1EA3n xu\u1EA5t v\xE0 \u0111\u1EDDi s\u1ED1ng \u1EA5m no, h\u1EA1nh
    ph\xFAc v\xE0 thanh b\xECnh. Trong tranh, l\u1EE3n m\u1EB9 v\xE0 l\u1EE3n con
    \u0111\u1EC1u c\xF3 hai xo\xE1y v\xF2ng tr\xF2n \xE2m d\u01B0\u01A1ng, th\u1EC3
    hi\u1EC7n c\u1EE7a s\u1EF1 v\u1EADn \u0111\u1ED9ng kh\xF4ng ng\u1EEBng v\xE0
    chuy\u1EC3n h\xF3a qua l\u1EA1i gi\u1EEFa \xE2m v\xE0 d\u01B0\u01A1ng. S\u1EF1
    k\u1EBFt h\u1EE3p \xE2m - d\u01B0\u01A1ng \u0111em l\u1EA1i s\u1EF1 c\xE2n b\u1EB1ng
    v\xE0 ph\xE1t tri\u1EC3n t\u1ED1t \u0111\u1EB9p, t\u01B0\u01A1ng t\u1EF1 nh\u01B0
    s\u1EF1 c\xE2n b\u1EB1ng gi\u1EEFa ng\u01B0\u1EDDi v\u1EE3 v\xE0 ng\u01B0\u1EDDi
    ch\u1ED3ng trong gia \u0111\xECnh. N\u1EBFu m\u1ED7i ng\u01B0\u1EDDi th\u1EF1c
    hi\u1EC7n \u0111\xFAng thi\xEAn ch\u1EE9c c\u1EE7a m\xECnh, gia \u0111\xECnh
    s\u1EBD lu\xF4n h\xE0i h\xF2a v\xE0 t\u1EA1o m\xF4i tr\u01B0\u1EDDng t\u1ED1t
    \u0111\u1EC3 ph\xFAc kh\xED sinh s\xF4i, ph\xE1t tri\u1EC3n. Treo tranh \u0110\xF4ng
    H\u1ED3 l\u1EE3n \u0111\xE0n kh\xF4ng ch\u1EC9 \u0111\u1EC3 c\u1EA7u may m\u1EAFn
    m\xE0 c\xF2n \u0111\u1EC3 nh\u1EAFc nh\u1EDF v\u1EC1 gi\xE1 tr\u1ECB c\u1EE7a
    s\u1EF1 c\xE2n b\u1EB1ng v\xE0 ph\xE1t tri\u1EC3n trong cu\u1ED9c s\u1ED1ng."
  anhTranh: {fileID: 21300000, guid: aa6a7f4b1085dd846ac69332c154e046, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 0324c359e2c8679448557cd2357aa80d, type: 3}

  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Em_b\xE9_\xF4m_c\xF3c"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Nh\xE2n Ngh\u0129a"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t c\u1EADu b\xE9
    trai b\u1EE5 b\u1EABm \u0111ang \xF4m ch\xFA c\xF3c m\u1ED9t c\xE1ch tr\xECu
    m\u1EBFn. Trong v\u0103n h\xF3a d\xE2n gian, con c\xF3c tuy x\xF9 x\xEC nh\u01B0ng
    l\xE0 \"c\u1EADu \xF4ng Tr\u1EDDi\", \u0111\u1EA1i di\u1EC7n cho s\u1EF1 d\u0169ng
    c\u1EA3m d\xE1m \u0111\u1EA5u tranh \u0111\xF2i m\u01B0a thu\u1EADn gi\xF3 h\xF2a
    cho d\xE2n l\xE0ng. B\u1EE9c tranh g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc cho con
    tr\u1EBB khi l\u1EDBn l\xEAn s\u1EBD tr\u1EDF th\xE0nh ng\u01B0\u1EDDi c\xF3
    t\xE0i, c\xF3 \u0111\u1EE9c, gi\xE0u l\xF2ng \"Nh\xE2n Ngh\u0129a\", bi\u1EBFt
    y\xEAu th\u01B0\u01A1ng m\u1ECDi ng\u01B0\u1EDDi v\xE0 d\u0169ng c\u1EA3m b\u1EA3o
    v\u1EC7 l\u1EBD ph\u1EA3i, c\xF4ng l\xFD trong x\xE3 h\u1ED9i."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "C\xF3c \u0111\u01B0\u1EE3c d\xE2n gian xem l\xE0 \u201Cc\u1EADu \xF4ng Tr\u1EDDi\u201D,
    g\u1ECDi \u0111\u01B0\u1EE3c m\u01B0a thu\u1EADn gi\xF3 h\xF2a n\xEAn g\u1EAFn
    v\u1EDBi \u01B0\u1EDBc v\u1ECDng m\xF9a m\xE0ng b\u1ED9i thu. H\xECnh \u1EA3nh
    em b\xE9 m\u0169m m\u0129m \xF4m c\xF3c g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc con
    ch\xE1u kh\u1ECFe m\u1EA1nh, nhanh nh\u1EB9n, gia \u0111\xECnh no \u0111\u1EE7
    v\xE0 b\xECnh an."
  anhTranh: {fileID: 21300000, guid: 19c8099b08d3573478dcea222ef6ba36, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 9d5a6d1bc89d5044aa562c22cae58ad7, type: 3}

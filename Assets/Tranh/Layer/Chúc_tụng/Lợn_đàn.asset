  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "L\u1EE3n_\u0111\xE0n"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "L\u1EE3n \u0110\xE0n"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t con l\u1EE3n
    m\u1EB9 b\xE9o kh\u1ECFe \u0111ang qu\xE2y qu\u1EA7n b\xEAn \u0111\xE0n l\u1EE3n
    con, tr\xEAn m\xECnh m\u1ED7i con \u0111\u1EC1u mang nh\u1EEFng xo\xE1y \xE2m
    d\u01B0\u01A1ng t\u01B0\u1EE3ng tr\u01B0ng cho s\u1EF1 h\xE0i h\xF2a c\u1EE7a
    \u0111\u1EA5t tr\u1EDDi. Trong v\u0103n h\xF3a n\xF4ng nghi\u1EC7p, h\xECnh \u1EA3nh
    n\xE0y bi\u1EC3u tr\u01B0ng cho s\u1EF1 sinh s\xF4i n\u1EA3y n\u1EDF, \"con \u0111\xE0n
    ch\xE1u \u0111\u1ED1ng\" v\xE0 cu\u1ED9c s\u1ED1ng \u1EA5m no, d\u01B0 d\u1EA3.
    B\u1EE9c tranh g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc cho gia \u0111\xECnh lu\xF4n
    h\xF2a thu\u1EADn, sung t\xFAc, kinh doanh ph\xE1t \u0111\u1EA1t v\xE0 ch\u0103n
    nu\xF4i g\u1EB7p nhi\u1EC1u thu\u1EADn l\u1EE3i, may m\u1EAFn."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "Tranh \u0110\xF4ng H\u1ED3 \u201CL\u1EE3n \u0110\xE0n\u201D l\xE0 m\u1ED9t
    trong nh\u1EEFng t\xE1c ph\u1EA9m ti\xEAu bi\u1EC3u v\xE0 gi\xE0u \xFD ngh\u0129a
    nh\u1EA5t c\u1EE7a d\xF2ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3, kh\u1EAFc
    h\u1ECDa h\xECnh \u1EA3nh th\xE2n thu\u1ED9c c\u1EE7a lo\xE0i l\u1EE3n \u2013
    m\u1ED9t con v\u1EADt g\u1EAFn li\u1EC1n v\u1EDBi \u0111\u1EDDi s\u1ED1ng n\xF4ng
    th\xF4n Vi\u1EC7t Nam v\xE0 mang \u0111\u1EADm gi\xE1 tr\u1ECB v\u0103n h\xF3a
    truy\u1EC1n th\u1ED1ng."
  anhTranh: {fileID: 21300000, guid: abc3e86530266e84d888976025d6f3f0, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 84f0a10f68eafa74d97c6fb7fc973b7f, type: 3}

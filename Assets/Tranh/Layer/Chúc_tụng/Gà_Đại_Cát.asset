  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "G\xE0_\u0110\u1EA1i_C\xE1t"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "G\xE0 \u0110\u1EA1i C\xE1t C\xE1t"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa m\u1ED9t ch\xFA g\xE0 tr\u1ED1ng oai
    v\u1EC7, d\u0169ng m\xE3nh \u0111ang ng\u1EADm m\u1ED9t b\xF4ng h\u1ED3ng n\u1EDF
    r\u1ED9, b\xEAn c\u1EA1nh l\xE0 hai ch\u1EEF ch\u1EEF H\xE1n \"\u0110\u1EA1i
    C\xE1t\" (\u5927\u5409). Trong phong th\u1EE7y, \"\u0110\u1EA1i C\xE1t\" mang
    \xFD ngh\u0129a l\xE0 \u0111i\u1EC1m l\xE0nh l\u1EDBn, s\u1EF1 may m\u1EAFn v\xE0
    thu\u1EADn l\u1EE3i t\u1ED1i cao. H\xECnh \u1EA3nh ch\xFA g\xE0 tr\u1ED1ng d\u0169ng
    c\u1EA3m, kh\xED ti\u1EBFt k\u1EBFt h\u1EE3p v\u1EDBi ch\u1EEF \u0110\u1EA1i
    C\xE1t l\xE0 l\u1EDDi ch\xFAc cho gia ch\u1EE7 g\u1EB7t h\xE1i \u0111\u01B0\u1EE3c
    nhi\u1EC1u t\xE0i l\u1ED9c, c\xF4ng danh th\u0103ng ti\u1EBFn, s\u1EF1 nghi\u1EC7p
    hanh th\xF4ng v\xE0 lu\xF4n g\u1EB7p d\u1EEF h\xF3a l\xE0nh."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "Tranh \u0110\xF4ng H\u1ED3 G\xE0 \u0110\u1EA1i C\xE1t th\u1EC3 hi\u1EC7n
    s\u1EF1 k\xEDnh tr\u1ECDng c\u1EE7a ng\u01B0\u1EDDi d\xE2n \u0111\u1ED1i v\u1EDBi
    g\xE0 v\xE0 \u0111\u01B0\u1EE3c cho l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a
    ng\u0169 \u0111\u1EE9c: v\u0103n \u2013 v\xF5 \u2013 d\u0169ng \u2013 nh\xE2n
    \u2013 t\xEDn. Theo H\xF5a Kinh, g\xE0 \u0111\u1EA1i c\xE1t \u0111\u01B0\u1EE3c
    m\xF4 t\u1EA3 qua nh\u1EEFng \u0111\u1EB7c \u0111i\u1EC3m sau \u0111\xE2y:\r\n\r\n\u0110\u1EA7u
    \u0111\u1ED9i m\u0169 (m\xE0o g\xE0 tr\u1ED1ng): \u0111\u1EA1i di\u1EC7n cho
    V\u0103n, chi\u1EBFc m\xE0o g\xE0 cao th\u1EB3ng th\u1EC3 hi\u1EC7n s\u1EF1 ki\xEAu
    h\xE3nh v\xE0 ch\xED kh\xED. T\u1EEB \"m\xE0o g\xE0\" trong ti\u1EBFng H\xE1n
    c\u0169ng c\xF3 \xE2m thanh gi\u1ED1ng v\u1EDBi \"quan\", do \u0111\xF3 m\xE0o
    g\xE0 \u0111\u01B0\u1EE3c coi l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a quan l\u1EA1i,
    v\xE0 c\xF3 t\xE1c d\u1EE5ng chi\xEAu t\xE0i, c\xF4ng th\xE0nh danh to\u1EA1i.\r\n\r\nB\u01B0\u1EDBc
    \u0111i nhanh l\xE0 V\xF5: G\xE0 \u0111\u1EA1i c\xE1t th\u01B0\u1EDDng \u0111i
    \u0111\u1EA7u \u0111\xE0n v\xE0 d\u1EABn d\u1EAFt \u0111\xE0n g\xE0 theo. H\xECnh
    d\u1EA1ng g\xE0 \u0111i nhanh nh\u1EB9n v\xE0 m\u1EA1nh m\u1EBD, th\u1EC3 hi\u1EC7n
    s\u1EE9c m\u1EA1nh v\xE0 v\xF5 ngh\u1EC7.\r\n\r\nG\u1EB7p \u0111\u1ECBch d\xE1m
    chi\u1EBFn \u0111\u1EA5u l\xE0 D\u0169ng: G\xE0 \u0111\u1EA1i c\xE1t di chuy\u1EC3n
    linh ho\u1EA1t v\xE0 \u0111\xE1nh nh\u1EEFng c\xFA m\u1ED5 chu\u1EA9n x\xE1c.
    Ch\xFAng c\xF3 th\u1EC3 \u0111\xE1nh b\u1EA1i c\u1EA3 r\u1EAFn \u0111\u1EC3 b\u1EA3o
    v\u1EC7 \u0111\xE0n g\xE0.\r\n\r\nC\xF3 mi\u1EBFng \u0103n bi\u1EBFt g\u1ECDi
    \u0111\xE0n l\xE0 Nh\xE2n: G\xE0 \u0111\u1EA1i c\xE1t s\u1EBD k\xEAu l\xEAn khi
    t\xECm th\u1EA5y th\u1EE9c \u0103n \u0111\u1EC3 c\u1EA3 \u0111\xE0n c\xF9ng nhau
    \u0111i t\xECm v\xE0 \u0103n chung.\r\n\r\nLu\xF4n c\u0103n g\xE1c ban \u0111\xEAm
    l\xE0 T\xEDn: G\xE0 \u0111\u1EA1i c\xE1t c\xF3 th\xF3i quen ng\u1EE7 s\u1EDBm
    v\xE0 th\u1EE9c d\u1EADy v\xE0o ban \u0111\xEAm. Ti\u1EBFng g\xE1y c\u1EE7a ch\xFAng
    v\xE0o s\xE1ng s\u1EDBm l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a b\xECnh minh
    v\xE0 kh\u01A1i g\u1EE3i s\u1EF1 hi v\u1ECDng. G\xE0 \u0111\u1EA1i c\xE1t c\u0169ng
    th\u01B0\u1EDDng xuy\xEAn t\u1EA5n c\xF4ng v\xE0 ph\xF2ng th\u1EE7 v\xE0o ban
    \u0111\xEAm, bi\u1EC3u th\u1ECB s\u1EF1 can tr\u01B0\u1EDDng v\xE0 t\xEDn nhi\u1EC7m."
  anhTranh: {fileID: 21300000, guid: 83ff300b2b6a0fc4bbc8caae40565af7, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 99774311edbffe24995917f4f501fd04, type: 3}

  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Em_b\xE9_\xF4m_vit"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Ph\xFA Qu\xFD"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t b\xE9 g\xE1i
    b\u1EE5 b\u1EABm, d\u1EC5 th\u01B0\u01A1ng \xF4m ch\xFA v\u1ECBt tr\u1EAFng b\xE9o
    tr\xF2n b\xEAn c\u1EA1nh kh\xF3m hoa sen ng\xE1t h\u01B0\u01A1ng. Trong v\u0103n
    h\xF3a d\xE2n gian, con v\u1ECBt tr\u1EAFng t\u01B0\u1EE3ng tr\u01B0ng cho s\u1EF1
    hi\u1EC1n l\xE0nh, \u0111\u1EA3m \u0111ang v\xE0 m\xE1t m\u1EBB, trong khi hoa
    sen \u0111\u1EA1i di\u1EC7n cho s\u1EF1 thanh cao, thu\u1EA7n khi\u1EBFt. B\u1EE9c
    tranh g\u1EEDi g\u1EAFm l\u1EDDi ch\xFAc cho gia \u0111\xECnh sinh \u0111\u01B0\u1EE3c
    con g\xE1i n\u1EBFt na, \u0111\u1EA3m \u0111ang, \u0111\u1ED3ng th\u1EDDi mang
    l\u1EA1i cu\u1ED9c s\u1ED1ng \"Ph\xFA Qu\xFD\" \u2013 gi\xE0u sang, an khang,
    gia \u0111\u1EA1o lu\xF4n \xEAm \u1EA5m v\xE0 sung t\xFAc."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "Tranh \u0110\xF4ng H\u1ED3 \"Em B\xE9 \xD4m V\u1ECBt\" l\xE0 m\u1ED9t t\xE1c
    ph\u1EA9m ngh\u1EC7 thu\u1EADt d\xE2n gian mang \u0111\u1EADm gi\xE1 tr\u1ECB
    v\u0103n h\xF3a v\xE0 c\u1EA3m x\xFAc. B\u1EE9c tranh kh\xF4ng ch\u1EC9 l\xE0
    h\xECnh \u1EA3nh \u0111\u1EB9p m\u1EAFt m\xE0 c\xF2n g\u1EEDi g\u1EAFm th\xF4ng
    \u0111i\u1EC7p v\u1EC1 s\u1EF1 no \u0111\u1EE7, h\u1EA1nh ph\xFAc v\xE0 t\xECnh
    c\u1EA3m gia \u0111\xECnh \u1EA5m \xE1p.\r\n\r\nH\xECnh \u1EA3nh em b\xE9 \xF4m
    con v\u1ECBt v\u1EDBi n\u1EE5 c\u01B0\u1EDDi r\u1EA1ng r\u1EE1 th\u1EC3 hi\u1EC7n
    ni\u1EC1m vui, hy v\u1ECDng v\xE0 \u01B0\u1EDBc m\u01A1 h\u1ED3n nhi\xEAn c\u1EE7a
    tu\u1ED5i th\u01A1. Con v\u1ECBt l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a t\xE0i
    l\u1ED9c v\xE0 may m\u1EAFn, trong khi b\xF4ng sen ph\xEDa sau t\u01B0\u1EE3ng
    tr\u01B0ng cho s\u1EF1 tinh khi\u1EBFt, thanh cao. T\u1EA5t c\u1EA3 h\xF2a quy\u1EC7n
    t\u1EA1o n\xEAn m\u1ED9t t\u1ED5ng th\u1EC3 h\xE0i h\xF2a, nh\u1EB9 nh\xE0ng
    nh\u01B0ng \u0111\u1EA7y chi\u1EC1u s\xE2u v\u1EC1 m\u1EB7t \xFD ngh\u0129a."
  anhTranh: {fileID: 21300000, guid: 3c4cfd49de2735d4db6a7bd553209aac, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 461d18b27a652714086b53904e87b64b, type: 3}

  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "L\xFD_Ng\u01B0_V\u1ECDng_Nguy\u1EC7t"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "L\xFD Ng\u01B0 V\u1ECDng Nguy\u1EC7t "
  yNghia: "C\xE1 ch\xE9p l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a s\u1EF1 ki\xEAn
    tr\xEC, kh\xE1t v\u1ECDng v\u01B0\u01A1n l\xEAn v\u01B0\u1EE3t m\u1ECDi kh\xF3
    kh\u0103n \u0111\u1EC3 \"h\xF3a r\u1ED3ng\", mang l\u1EA1i may m\u1EAFn v\xE0
    th\u1ECBnh v\u01B0\u1EE3ng cho gia ch\u1EE7. H\xECnh \u1EA3nh c\xE1 ch\xE9p ng\u1EAFm
    b\xF3ng tr\u0103ng tr\xF2n soi d\u01B0\u1EDBi m\u1EB7t n\u01B0\u1EDBc g\u1EE3i
    l\xEAn \u01B0\u1EDBc mu\u1ED1n v\u1EC1 s\u1EF1 ho\xE0n m\u1EF9, vi\xEAn m\xE3n
    tr\xF2n \u0111\u1EA7y, \u0111\u1ED3ng th\u1EDDi nh\u1EAFc nh\u1EDF con ng\u01B0\u1EDDi
    h\u01B0\u1EDBng \u0111\u1EBFn nh\u1EEFng gi\xE1 tr\u1ECB \u0111\xEDch th\u1EF1c,
    tr\xE1nh xa s\u1EF1 \u1EA3o \u1EA3nh, ph\xF9 phi\u1EBFm c\u1EE7a cu\u1ED9c \u0111\u1EDDi."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "B\u1EE9c tranh \u0110\xF4ng H\u1ED3 \u201CL\xFD Ng\u01B0 V\u1ECDng Nguy\u1EC7t\u201D,
    c\xF2n g\u1ECDi l\xE0 \u201CC\xE1 Ch\xE9p Tr\xF4ng Tr\u0103ng\u201D, l\xE0 m\u1ED9t
    t\xE1c ph\u1EA9m ngh\u1EC7 thu\u1EADt d\xE2n gian \u0111\u1EB7c s\u1EAFc, \u1EA9n
    ch\u1EE9a nhi\u1EC1u l\u1EDBp \xFD ngh\u0129a s\xE2u xa trong t\xEDn ng\u01B0\u1EE1ng
    v\xE0 t\xE2m th\u1EE9c ng\u01B0\u1EDDi Vi\u1EC7t. Kh\xF4ng ch\u1EC9 l\xE0 h\xECnh
    \u1EA3nh quen thu\u1ED9c trong \u0111\u1EDDi s\u1ED1ng n\xF4ng th\xF4n, c\xE1
    ch\xE9p trong tranh l\xE0 bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a s\u1EF1 n\u1ED7
    l\u1EF1c, th\xE0nh c\xF4ng, v\xE0 kh\xE1t v\u1ECDng v\u01B0\u01A1n l\xEAn."
  anhTranh: {fileID: 21300000, guid: 9cfb639173c941c4b8e12b7f58e6cd30, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: adc06ec04c5fb764db61fa945a3589a8, type: 3}

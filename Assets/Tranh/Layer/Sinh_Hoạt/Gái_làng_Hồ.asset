  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "G\xE1i_l\xE0ng_H\u1ED3"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "G\xE1i L\xE0ng H\u1ED3"
  yNghia: "B\u1EE9c tranh G\xE1i L\xE0ng H\u1ED3 ph\xE1c h\u1ECDa s\u1ED1ng \u0111\u1ED9ng
    v\xE0 ch\xE2n th\u1EF1c h\xECnh \u1EA3nh ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF Vi\u1EC7t
    Nam x\u01B0a trong trang ph\u1EE5c truy\u1EC1n th\u1ED1ng \u0111ang mi\u1EC7t
    m\xE0i g\xE1nh v\xE1c c\xF4ng vi\u1EC7c d\u1EC7t v\u1EA3i, may v\xE1. T\xE1c
    ph\u1EA9m t\xF4n vinh n\xE9t \u0111\u1EB9p lao \u0111\u1ED9ng tr\xE2n qu\xFD,
    ph\u1EA9m ch\u1EA5t duy\xEAn d\xE1ng, ch\u1ECBu th\u01B0\u01A1ng ch\u1ECBu kh\xF3
    v\xE0 s\u1EF1 \u0111\u1EA3m \u0111ang, kh\xE9o l\xE9o c\u1EE7a ng\u01B0\u1EDDi
    con g\xE1i \u0111\u1EA5t Kinh B\u1EAFc. Treo tranh nh\u01B0 m\u1ED9t l\u1EDDi
    ng\u1EE3i ca, tr\xE2n tr\u1ECDng v\u1ECB th\u1EBF c\u1EE7a ng\u01B0\u1EDDi ph\u1EE5
    n\u1EEF trong gia \u0111\xECnh, \u0111\u1ED3ng th\u1EDDi c\u1EA7u mong gia \u0111\u1EA1o
    lu\xF4n n\u1EC1 n\u1EBFp, \u1EA5m \xEAm, c\xF3 b\xE0n tay ng\u01B0\u1EDDi v\u1EE3,
    ng\u01B0\u1EDDi m\u1EB9 vun v\xE9n h\u1EA1nh ph\xFAc vun \u0111\u1EA7y."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: " Xu\u1EA5t x\u1EE9: T\u1EEB l\xE0ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3
    (Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh), kh\u1EAFc h\u1ECDa ch\xE2n dung ng\u01B0\u1EDDi
    con g\xE1i v\xF9ng Kinh B\u1EAFc x\u01B0a duy\xEAn d\xE1ng trong b\u1ED9 trang
    ph\u1EE5c truy\u1EC1n th\u1ED1ng.\n \xDD ngh\u0129a: T\xF4n vinh v\u1EBB \u0111\u1EB9p
    n\u1EC1n n\xE3, th\u1EE5c n\u1EEF v\xE0 kh\xE9o l\xE9o c\u1EE7a ng\u01B0\u1EDDi
    ph\u1EE5 n\u1EEF Vi\u1EC7t Nam; c\u1EA7u ch\xFAc gia \u0111\u1EA1o b\xECnh an,
    h\u1EA1nh ph\xFAc v\xE0 v\u1EA1n s\u1EF1 c\xE1t t\u01B0\u1EDDng."
  anhTranh: {fileID: 21300000, guid: b09ea547903b80543840ac874f87749d, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 159a7654e7aef2c48abe6d518024fa42, type: 3}

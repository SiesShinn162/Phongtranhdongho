  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Tr\u1ECDi_Tr\xE2u"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Ch\u1ECDi Tr\xE2u"
  yNghia: "B\u1EE9c tranh Ch\u1ECDi Tr\xE2u t\xE1i hi\u1EC7n sinh \u0111\u1ED9ng
    m\u1ED9t phong t\u1EE5c, l\u1EC5 h\u1ED9i th\u01B0\u1EE3ng v\xF5 l\xE2u \u0111\u1EDDi
    t\u1EA1i c\xE1c v\xF9ng qu\xEA Vi\u1EC7t Nam (nh\u01B0 l\u1EC5 h\u1ED9i ch\u1ECDi
    tr\xE2u \u0110\u1ED3 S\u01A1n). H\xECnh \u1EA3nh hai ch\xFA tr\xE2u oai d\u0169ng
    \u0111ang lao v\xE0o \u0111\u1EA5u \u0111\u1EA7u nhau d\u01B0\u1EDBi l\xE1 c\u1EDD
    ng\u0169 s\u1EAFc \"H\u1ED9i ch\xED l\u1EA7u\" bi\u1EC3u tr\u01B0ng cho tinh
    th\u1EA7n ki\xEAn c\u01B0\u1EDDng, s\u1EE9c m\u1EA1nh th\u1EC3 ch\u1EA5t v\u01B0\u1EE3t
    tr\u1ED9i v\xE0 \xFD ch\xED chi\u1EBFn th\u1EAFng. Trong \u0111\u1EDDi s\u1ED1ng
    n\xF4ng nghi\u1EC7p, vi\u1EC7c t\u1ED5 ch\u1EE9c h\u1ED9i ch\u1ECDi tr\xE2u mang
    \xFD ngh\u0129a t\xE2m linh s\xE2u s\u1EAFc nh\u1EB1m c\u1EA7u mong m\u01B0a
    thu\u1EADn gi\xF3 h\xF2a, m\xF9a m\xE0ng t\u01B0\u01A1i t\u1ED1t v\xE0 th\u1EC3
    hi\u1EC7n \u01B0\u1EDBc v\u1ECDng v\u1EC1 m\u1ED9t cu\u1ED9c s\u1ED1ng kh\u1ECFe
    m\u1EA1nh, can tr\u01B0\u1EDDng, th\u1ECBnh v\u01B0\u1EE3ng c\u1EE7a ng\u01B0\u1EDDi
    n\xF4ng d\xE2n b\u01B0\u1EDBc v\xE0o n\u0103m m\u1EDBi."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: " Xu\u1EA5t x\u1EE9: T\u1EEB l\xE0ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3
    (Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh), ghi l\u1EA1i khung c\u1EA3nh c\u1EE7a l\u1EC5
    h\u1ED9i ch\u1ECDi tr\xE2u truy\u1EC1n th\u1ED1ng t\u1EA1i c\xE1c l\xE0ng qu\xEA
    Vi\u1EC7t Nam x\u01B0a. Tr\xEAn tranh th\u01B0\u1EDDng xu\u1EA5t hi\u1EC7n c\u1EDD
    ng\u0169 s\u1EAFc ghi ch\u1EEF \"H\u1ED9i ch\xED l\u1EA7u\" c\xF9ng bi\u1EC3n
    hi\u1EC7u c\u1EE7a hai \u0111\u1ED9i \u0111\u1EA5u (nh\u01B0 \"\u0110\xF4ng x\xE3\"
    v\xE0 \"T\u1ED1ng x\xE3\").\n \xDD ngh\u0129a: T\xF4n vinh tinh th\u1EA7n th\u01B0\u1EE3ng
    v\xF5, s\u1EE9c m\u1EA1nh d\u1EBBo dai v\xE0 n\xE9t \u0111\u1EB9p v\u0103n h\xF3a
    c\u1ED9ng \u0111\u1ED3ng g\u1EAFn k\u1EBFt tinh th\u1EA7n \u0111o\xE0n k\u1EBFt
    l\xE0ng x\xE3; \u0111\u1ED3ng th\u1EDDi g\u1EEDi g\u1EAFm mong \u01B0\u1EDBc
    b\u01B0\u1EDBc sang n\u0103m m\u1EDBi m\u01B0a thu\u1EADn gi\xF3 h\xF2a, m\xF9a
    m\xE0ng b\u1ED9i thu v\xE0 gia \u0111\u1EA1o lu\xF4n r\u1ED9n r\xE0ng, h\xE2n
    hoan."
  anhTranh: {fileID: 21300000, guid: 30774cca5400ddb46b413c615155a11e, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: a3de32bc702c6a64781175cc751c1b7a, type: 3}

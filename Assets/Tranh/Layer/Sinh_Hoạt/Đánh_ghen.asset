  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "\u0110\xE1nh_ghen"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tranh D\xE2n Gian \u0110\xF4ng H\u1ED3 \u0110\xE1nh Ghen"
  yNghia: "B\u1EE9c tranh \u0110\xE1nh Ghen l\xE0 m\u1ED9t t\xE1c ph\u1EA9m mang
    t\xEDnh sinh ho\u1EA1t \u0111\u1EDDi th\u01B0\u1EDDng, ng\u1EE5 ng\xF4n v\xE0
    tr\xE0o ph\xFAng s\xE2u s\u1EAFc c\u1EE7a d\xF2ng tranh \u0110\xF4ng H\u1ED3,
    ph\u1EA3n \xE1nh hi\u1EC7n th\u1EF1c v\u1EC1 ch\u1EBF \u0111\u1ED9 \u0111a th\xEA
    (m\u1ED9t \xF4ng hai b\xE0) trong x\xE3 h\u1ED9i phong ki\u1EBFn x\u01B0a.\nTranh
    kh\u1EAFc h\u1ECDa m\u1ED9t b\u1ED1i c\u1EA3nh \u0111\u1EA7y bi h\xE0i k\u1ECBch
    v\u1EDBi c\xE1c nh\xE2n v\u1EADt \u0111\u1EB7c tr\u01B0ng:\n\u2022 Ng\u01B0\u1EDDi
    v\u1EE3 c\u1EA3: T\xF3c b\xFAi cao g\u1ECDn g\xE0ng, tay tr\xE1i ch\u1ED1ng n\u1EA1nh,
    tay ph\u1EA3i gi\u01A1 cao chi\u1EBFc k\xE9o l\u1EDBn \u0111\u1EC3 \u0111\xF2i
    c\u1EAFt t\xF3c c\xF4 nh\xE2n t\xECnh.\n\u2022 C\xF4 v\u1EE3 l\u1EBD: Tr\u1EBB
    trung, l\u1EB3ng l\u01A1, c\u1EDFi \xE1o khi\xEAu kh\xEDch v\xE0 \u0111\u1EA7y
    th\xE1ch th\u1EE9c tr\u01B0\u1EDBc c\u01A1n gi\u1EADn c\u1EE7a v\u1EE3 c\u1EA3.\n\u2022
    Ng\u01B0\u1EDDi ch\u1ED3ng: B\u1ECB b\u1EAFt qu\u1EA3 tang nh\u01B0ng l\xE2m
    v\xE0o th\u1EBF ti\u1EBFn tho\xE1i l\u01B0\u1EE1ng nan, m\u1ED9t tay gi\u01A1
    l\xEAn can ng\u0103n v\u1EE3 c\u1EA3, tay kia l\u1EA1i \u0111\u1EB7t l\xEAn ng\u1EF1c
    v\u1EE3 l\u1EBD \u0111\u1EC3 che ch\u1EDF, b\u1EA3o v\u1EC7.\n\u2022 \u0110\u1EE9a
    con trai: \u0110\u1EE9ng ph\xEDa sau ch\u1EAFp tay van l\u1EA1y, kh\xF3c l\xF3c
    tr\u01B0\u1EDBc c\u1EA3nh h\u1ED7n eo c\u1EE7a b\u1EADc ph\u1EE5 m\u1EABu.\nT\xE1c
    ph\u1EA9m d\xF9ng ti\u1EBFng c\u01B0\u1EDDi d\xE2n gian \u0111\u1EC3 ph\xEA ph\xE1n
    th\xF3i tr\u0103ng hoa, \u0111a th\xEA, \u0111\u1ED3ng th\u1EDDi l\xE0 l\u1EDDi
    r\u0103n d\u1EA1y nh\u1EB9 nh\xE0ng nh\u01B0ng th\u1EA5m th\xEDa v\u1EC1 \u0111\u1EA1o
    \u0111\u1EE9c, nh\u1EAFc nh\u1EDF con ng\u01B0\u1EDDi gi\u1EEF g\xECn s\u1EF1
    chung th\u1EE7y, b\xECnh \u0111\u1EB3ng v\xE0 b\u1EA3o v\u1EC7 h\u1EA1nh ph\xFAc,
    n\u1EC1 n\u1EBFp gia \u0111\xECnh"
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "Tranh \u0110\xF4ng H\u1ED3 \u0110\xE1nh Ghen thu\u1ED9c d\xF2ng tranh truy\u1EC1n
    th\u1ED1ng t\u1EEB l\xE0ng ngh\u1EC1 l\xE0m tranh \u0110\xF4ng H\u1ED3 t\u1EA1i
    Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh. Tranh \u0111\u01B0\u1EE3c v\u1EBD tr\xEAn
    gi\u1EA5y d\xF3 hay c\xF2n g\u1ECDi l\xE0 gi\u1EA5y \u0111i\u1EC7p v\xE0 t\u1EEBng
    m\u1EA3ng m\xE0u trong tranh \u0111\u01B0\u1EE3c in b\u1EA3n kh\u1EAFc g\u1ED7
    m\u1ED9t l\u1EA7n. C\xE1c ngh\u1EC7 nh\xE2n \u0111\xE3 t\u1EC9 m\u1EA9n v\u1EBD
    b\u1EA3n m\u1EABu v\xE0 kh\u1EAFc tr\xEAn b\u1EA3n g\u1ED7. S\u1ED1 l\u1EA7n
    in t\u01B0\u01A1ng \u0111\u01B0\u01A1ng v\u1EDBi s\u1ED1 l\u01B0\u1EE3ng m\xE0u
    s\u1EAFc trong tranh. \u0110\xE2y l\xE0 \u0111\u1EB7c tr\u01B0ng ri\xEAng c\u1EE7a
    tranh \u0110\xF4ng H\u1ED3, c\xF2n \u0111\u01B0\u1EE3c g\u1ECDi l\xE0 tranh in
    b\u1EA3n kh\u1EAFc g\u1ED7."
  anhTranh: {fileID: 21300000, guid: 12f1da47e34230241b358835957cde41, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: f3123db7a1f888c40a0e3604d5ebc01a, type: 3}

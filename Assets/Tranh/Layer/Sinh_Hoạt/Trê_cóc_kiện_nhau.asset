  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Tr\xEA_c\xF3c_ki\u1EC7n_nhau"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tr\xEA C\xF3c Ki\u1EC7n Nhau"
  yNghia: "B\u1EE9c tranh Tr\xEA C\xF3c Ki\u1EC7n Nhau l\xE0 t\xE1c ph\u1EA9m mang
    t\xEDnh ng\u1EE5 ng\xF4n v\xE0 tr\xE0o ph\xFAng s\xE2u s\u1EAFc b\u1EADc nh\u1EA5t
    c\u1EE7a d\xF2ng tranh \u0110\xF4ng H\u1ED3, m\u01B0\u1EE3n c\xE2u chuy\u1EC7n
    tranh ch\u1EA5p quy\u1EC1n nu\xF4i con gi\u1EEFa v\u1EE3 ch\u1ED3ng nh\xE0 C\xF3c
    v\xE0 c\xE1 Tr\xEA \u1EDF ch\u1ED1n c\xF4ng \u0111\u01B0\u1EDDng. H\xECnh \u1EA3nh
    \xF4ng quan x\u1EED ki\u1EC7n (th\u01B0\u1EDDng l\xE0 c\xE1 G\xE1y ho\u1EB7c
    c\u1EE5 R\xF9a) oai nghi\xEAm ng\u1ED3i tr\xEAn cao, hai b\xEAn l\xE0 nha l\u1EA1i
    t\xF4m, cua bi\u1EC3u tr\u01B0ng cho m\u1ED9t x\xE3 h\u1ED9i \u0111\u01B0\u1EE3c
    nh\xE2n c\xE1ch h\xF3a m\u1ED9t c\xE1ch h\xF3m h\u1EC9nh. T\xE1c ph\u1EA9m mang
    \xFD ngh\u0129a ch\xE2m bi\u1EBFm, ph\xEA ph\xE1n th\xF3i quan li\xEAu, tham
    nh\u0169ng c\u1EE7a t\u1EA7ng l\u1EDBp th\u1ED1ng tr\u1ECB phong ki\u1EBFn x\u01B0a,
    n\u01A1i l\xFD ph\u1EA3i th\u01B0\u1EDDng thu\u1ED9c v\u1EC1 k\u1EBB c\xF3 ti\u1EC1n,
    c\xF3 quy\u1EC1n. B\u1EE9c tranh g\u1EEDi g\u1EAFm l\u1EDDi r\u0103n d\u1EA1y
    th\u1EBF h\u1EC7 sau v\u1EC1 l\u1ED1i s\u1ED1ng ch\xEDnh tr\u1EF1c, \u0111\u1ED3ng
    th\u1EDDi ca ng\u1EE3i t\xECnh y\xEAu th\u01B0\u01A1ng con c\xE1i s\xE2u n\u1EB7ng,
    kh\xE1t v\u1ECDng \u0111\xF2i l\u1EA1i c\xF4ng l\xFD c\u1EE7a ng\u01B0\u1EDDi
    lao \u0111\u1ED9ng th\u1EA5p c\u1ED5 b\xE9 h\u1ECDng."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "B\u1EE9c tranh \u0110\xF4ng H\u1ED3 Tr\xEA C\xF3c Ki\u1EC7n Nhau D\xE1n
    M\xE0nh l\xE0 m\u1ED9t t\xE1c ph\u1EA9m truy\u1EC1n th\u1ED1ng trong d\xF2ng
    tranh \u0110\xF4ng H\u1ED3, d\u1EF1a tr\xEAn truy\u1EC7n n\xF4m \"Tr\xEA c\xF3c\"
    - m\u1ED9t truy\u1EC7n n\u1ED5i ti\u1EBFng v\xE0 \u0111\u01B0\u1EE3c coi l\xE0
    hay nh\u1EA5t trong truy\u1EC1n thuy\u1EBFt d\xE2n gian Vi\u1EC7t Nam. C\xE2u
    chuy\u1EC7n n\xE0y ch\u1EE9a \u0111\u1EF1ng nh\u1EEFng \xFD ngh\u0129a s\xE2u
    s\u1EAFc m\xE0 c\xE1c nh\xE0 h\u1ECDc hi\u1EC1n tri\u1EBFt \u0111\xE3 t\u1EEBng
    suy ng\u1EABm. T\xF3m t\u1EAFt c\u1EE7a c\xE2u truy\u1EC7n l\xE0 c\xF3c \u0111\u1EBB
    tr\u1EE9ng xu\u1ED1ng ao, Tr\xEA t\u01B0\u1EDFng nh\u1EA7m con c\xF3c l\xE0 con
    c\u1EE7a m\xECnh n\xEAn \u0111em c\u1EA3 \u0111\xE0n v\u1EC1 nu\xF4i. C\xF3c
    v\xE0 Tr\xEA r\u1ED3i \u0111\u01B0a nhau ra c\xF4ng \u0111\u01B0\u1EDDng \u0111\u1EC3
    gi\u1EA3i quy\u1EBFt tranh ch\u1EA5p. T\xEDnh bi k\u1ECBch h\xE0i h\u01B0\u1EDBc
    c\u1EE7a c\xE2u chuy\u1EC7n xu\u1EA5t ph\xE1t t\u1EEB s\u1EF1 ngu d\u1ED1t c\u1EE7a
    d\xE2n \u0111en v\xE0 tham nh\u0169ng c\u1EE7a quan l\u1EA1i."
  anhTranh: {fileID: 21300000, guid: 5f320f3fc3f69ac459bce5c43ba7a848, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 6231caf6e2a4f334fb3de0330ea68303, type: 3}

  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Tr\xEA_c\xF3c_ki\u1EC7n_nhau"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tranh D\xE2n Gian \u0110\xF4ng H\u1ED3 Tr\xEA C\xF3c Ki\u1EC7n Nhau"
  moTa: "B\u1EE9c tranh \u0110\xF4ng H\u1ED3 Tr\xEA C\xF3c Ki\u1EC7n Nhau D\xE1n
    M\xE0nh l\xE0 m\u1ED9t t\xE1c ph\u1EA9m truy\u1EC1n th\u1ED1ng trong d\xF2ng
    tranh \u0110\xF4ng H\u1ED3, d\u1EF1a tr\xEAn truy\u1EC7n n\xF4m \"Tr\xEA c\xF3c\"
    - m\u1ED9t truy\u1EC7n n\u1ED5i ti\u1EBFng v\xE0 \u0111\u01B0\u1EE3c coi l\xE0
    hay nh\u1EA5t trong truy\u1EC1n thuy\u1EBFt d\xE2n gian Vi\u1EC7t Nam. C\xE2u
    chuy\u1EC7n n\xE0y ch\u1EE9a \u0111\u1EF1ng nh\u1EEFng \xFD ngh\u0129a s\xE2u
    s\u1EAFc m\xE0 c\xE1c nh\xE0 h\u1ECDc hi\u1EC1n tri\u1EBFt \u0111\xE3 t\u1EEBng
    suy ng\u1EABm. T\xF3m t\u1EAFt c\u1EE7a c\xE2u truy\u1EC7n l\xE0 c\xF3c \u0111\u1EBB
    tr\u1EE9ng xu\u1ED1ng ao, Tr\xEA t\u01B0\u1EDFng nh\u1EA7m con c\xF3c l\xE0 con
    c\u1EE7a m\xECnh n\xEAn \u0111em c\u1EA3 \u0111\xE0n v\u1EC1 nu\xF4i. C\xF3c
    v\xE0 Tr\xEA r\u1ED3i \u0111\u01B0a nhau ra c\xF4ng \u0111\u01B0\u1EDDng \u0111\u1EC3
    gi\u1EA3i quy\u1EBFt tranh ch\u1EA5p. T\xEDnh bi k\u1ECBch h\xE0i h\u01B0\u1EDBc
    c\u1EE7a c\xE2u chuy\u1EC7n xu\u1EA5t ph\xE1t t\u1EEB s\u1EF1 ngu d\u1ED1t c\u1EE7a
    d\xE2n \u0111en v\xE0 tham nh\u0169ng c\u1EE7a quan l\u1EA1i."
  anhTranh: {fileID: 21300000, guid: 5f320f3fc3f69ac459bce5c43ba7a848, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: b398b4dffabbac24d8788aa9a9a7787a, type: 3}

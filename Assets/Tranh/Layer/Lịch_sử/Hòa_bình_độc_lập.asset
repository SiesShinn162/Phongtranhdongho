  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "H\xF2a_b\xECnh_\u0111\u1ED9c_l\u1EADp"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "B\u1EA3o V\u1EC7 H\xF2a B\xECnh - Ki\u1EBFn Thi\u1EBFt Qu\u1ED1c Gia "
  yNghia: "\u0110\xE2y l\xE0 t\xE1c ph\u1EA9m thu\u1ED9c d\xF2ng tranh c\u1ED5 \u0111\u1ED9ng
    th\u1EDDi k\u1EF3 kh\xE1ng chi\u1EBFn, ra \u0111\u1EDDi ngay sau ng\xE0y \u0111\u1EA5t
    n\u01B0\u1EDBc \u0111\u1ED9c l\u1EADp (2/9/1945). B\u1EE9c tranh ph\u1EA3n \xE1nh
    tinh th\u1EA7n b\xE1m s\xE1t th\u1EDDi cu\u1ED9c v\xE0 h\u01A1i th\u1EDF th\u1EDDi
    \u0111\u1EA1i c\u1EE7a c\xE1c ngh\u1EC7 nh\xE2n l\xE0ng H\u1ED3.\nT\xE1c ph\u1EA9m
    kh\u1EAFc h\u1ECDa \u01B0\u1EDBc v\u1ECDng to l\u1EDBn c\u1EE7a to\xE0n d\xE2n
    t\u1ED9c v\u1EC1 m\u1ED9t cu\u1ED9c s\u1ED1ng \u0111\u1ED9c l\u1EADp t\u1EF1
    ch\u1EE7, non s\xF4ng li\u1EC1n m\u1ED9t d\u1EA3i v\xE0 h\xF2a b\xECnh b\u1EC1n
    v\u1EEFng. Tranh c\u1ED5 v\u0169 m\u1EA1nh m\u1EBD phong tr\xE0o lao \u0111\u1ED9ng
    s\u1EA3n xu\u1EA5t, ki\u1EBFn thi\u1EBFt \u0111\u1EA5t n\u01B0\u1EDBc sau nh\u1EEFng
    n\u0103m th\xE1ng chi\u1EBFn tranh gian kh\u1ED5, \u0111\u1ED3ng th\u1EDDi l\xE0
    l\u1EDDi kh\u1EB3ng \u0111\u1ECBnh ch\u1EE7 quy\u1EC1n, tinh th\u1EA7n t\u1EF1
    h\xE0o d\xE2n t\u1ED9c m\xE3nh li\u1EC7t c\u1EE7a ng\u01B0\u1EDDi Vi\u1EC7t Nam
    b\u01B0\u1EDBc v\xE0o k\u1EF7 nguy\xEAn m\u1EDBi."
  nguonGoc: "Kh\xE1c v\u1EDBi c\xE1c d\xF2ng tranh ch\xFAc t\u1EE5ng c\u1ED5, t\xE1c
    ph\u1EA9m \u0111\u01B0\u1EE3c c\xE1c ngh\u1EC7 nh\xE2n (ti\xEAu bi\u1EC3u nh\u01B0
    ngh\u1EC7 nh\xE2n Nguy\u1EC5n Th\u1EC3 L\xE3m) s\xE1ng t\xE1c v\xE0 ph\xE1t tri\u1EC3n
    t\u1EEB sau n\u0103m 1945 t\u1EA1i l\xE0ng tranh \u0110\xF4ng H\u1ED3, Thu\u1EADn
    Th\xE0nh, B\u1EAFc Ninh. Tranh v\u1EABn gi\u1EEF tr\u1ECDn k\u1EF9 thu\u1EADt
    in kh\u1EAFc g\u1ED7 th\u1EE7 c\xF4ng tr\xEAn n\u1EC1n gi\u1EA5y d\xF3 qu\xE9t
    \u0111i\u1EC7p, th\u1EC3 hi\u1EC7n s\u1EF1 h\xF2a quy\u1EC7n \u0111\u1ED9c \u0111\xE1o
    gi\u1EEFa gi\xE1 tr\u1ECB v\u0103n h\xF3a truy\u1EC1n th\u1ED1ng v\xE0 tinh th\u1EA7n
    c\xE1ch m\u1EA1ng hi\u1EC7n \u0111\u1EA1i."
  moTa: " B\u1EE9c tranh ph\xE1c h\u1ECDa m\u1ED9t \u0111o\xE0n ng\u01B0\u1EDDi \u0111\u1EA1i
    di\u1EC7n cho c\xE1c t\u1EA7ng l\u1EDBp nh\xE2n d\xE2n (thanh ni\xEAn, ph\u1EE5
    n\u1EEF, ng\u01B0\u1EDDi gi\xE0, tr\u1EBB nh\u1ECF) \u0111ang h\xF2a m\xECnh
    v\xE0o b\u1EA7u kh\xF4ng kh\xED m\xEDt tinh, tu\u1EA7n h\xE0nh \u0103n m\u1EEBng
    chi\u1EBFn th\u1EAFng."
  anhTranh: {fileID: 21300000, guid: 9d2657e6a22aa834ebe3f95f348e94da, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: 64ffe2abac7d8924badf703e46ff5b1b, type: 3}

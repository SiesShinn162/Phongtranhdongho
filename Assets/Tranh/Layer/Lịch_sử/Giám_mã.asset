  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Gi\xE1m_m\xE3"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Gi\xE1m M\xE3"
  yNghia: "\"Gi\xE1m\" ngh\u0129a l\xE0 tr\xF4ng coi, qu\u1EA3n l\xFD; \"M\xE3\"
    l\xE0 ng\u1EF1a. B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh m\u1ED9t
    ng\u01B0\u1EDDi gi\xE1m m\xE3 (ng\u01B0\u1EDDi chuy\xEAn nu\xF4i d\u01B0\u1EE1ng,
    thu\u1EA7n h\xF3a ng\u1EF1a) \u0111ang d\u1EAFt m\u1ED9t ch\xFA ng\u1EF1a chi\u1EBFn
    d\u0169ng m\xE3nh, oai v\u1EC7.\n\u2022 Bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a Ng\u1EF1a:
    Trong v\u0103n h\xF3a d\xE2n gian, ng\u1EF1a \u0111\u1EA1i di\u1EC7n cho s\u1EE9c
    m\u1EA1nh l\u1EF1c l\u01B0\u1EE1ng, s\u1EF1 th\xF4ng minh, l\xF2ng trung th\xE0nh
    t\u1EADn t\u1EE5y v\xE0 kh\xE1t v\u1ECDng th\u0103ng ti\u1EBFn (\"M\xE3 \u0111\xE1o
    th\xE0nh c\xF4ng\").\n\u2022 Bi\u1EC3u t\u01B0\u1EE3ng ng\u01B0\u1EDDi Gi\xE1m
    m\xE3: \u0110\u1EA1i di\u1EC7n cho t\xEDnh k\u1EF7 lu\u1EADt, s\u1EF1 ki\xEAn
    nh\u1EABn, l\xF2ng ch\u1ECBu kh\xF3 v\xE0 tr\xE1ch nhi\u1EC7m.\nS\u1EF1 k\u1EBFt
    h\u1EE3p n\xE0y mang \xFD ngh\u0129a tri\u1EBFt l\xFD s\xE2u s\u1EAFc: M\u1ECDi
    t\xE0i n\u0103ng hay s\u1EE9c m\u1EA1nh (ch\xFA ng\u1EF1a) \u0111\u1EC1u c\u1EA7n
    c\xF3 s\u1EF1 r\xE8n luy\u1EC7n, \u0111\u1ECBnh h\u01B0\u1EDBng \u0111\xFAng
    \u0111\u1EAFn v\xE0 ki\u1EC3m so\xE1t kh\xF4n ngoan (ng\u01B0\u1EDDi gi\xE1m
    m\xE3) m\u1EDBi c\xF3 th\u1EC3 \u0111i \u0111\u1EBFn th\u1EAFng l\u1EE3i vi\xEAn
    m\u0129. B\u1EE9c tranh l\xE0 l\u1EDDi ch\xFAc cho gia ch\u1EE7 lu\xF4n gi\u1EEF
    \u0111\u01B0\u1EE3c s\u1EF1 ki\xEAn \u0111\u1ECBnh, s\xE1ng su\u1ED1t \u0111\u1EC3
    l\xE0m ch\u1EE7 cu\u1ED9c \u0111\u1EDDi, d\u1EABn d\u1EAFt s\u1EF1 nghi\u1EC7p
    v\u01B0\u1EE3t qua m\u1ECDi th\u1EED th\xE1ch, g\u1EB7t h\xE1i th\xE0nh c\xF4ng
    v\u1EEFng ch\u1EAFc."
  nguonGoc: "L\xE0 tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c in
    t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a l\xE0ng
    \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u s\u1EAFc
    t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn gi\u1EA5y
    d\xF3 qu\xE9t \u0111i\u1EC7p. (H\xECnh t\u01B0\u1EE3ng n\xE0y c\u0169ng xu\u1EA5t
    hi\u1EC7n ph\u1ED5 bi\u1EBFn trong d\xF2ng tranh d\xE2n gian Kim Ho\xE0ng)."
  moTa: " B\u1EE9c tranh t\u01B0\u1EE3ng tr\u01B0ng cho l\u1EDDi ch\xFAc m\xE3 \u0111\xE1o
    th\xE0nh c\xF4ng, th\u1EC3 hi\u1EC7n s\u1EF1 th\xF4ng minh, trung th\xE0nh, m\u1EA1nh
    m\u1EBD v\xE0 t\xECnh ngh\u0129a th\u1EE7y chung c\u1EE7a lo\xE0i ng\u1EF1a g\u1EAFn
    b\xF3 c\xF9ng con ng\u01B0\u1EDDi."
  anhTranh: {fileID: 21300000, guid: 9d035005e483e7b448d9e0f0ddfe6b37, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: b398b4dffabbac24d8788aa9a9a7787a, type: 3}

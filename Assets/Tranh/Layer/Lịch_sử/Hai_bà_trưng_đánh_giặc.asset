  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Hai_b\xE0_tr\u01B0ng_\u0111\xE1nh_gi\u1EB7c"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Hai B\xE0 Tr\u01B0ng \u0110\xE1nh Gi\u1EB7c"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh hai v\u1ECB n\u1EEF
    anh h\xF9ng d\xE2n t\u1ED9c l\xE0 Tr\u01B0ng Tr\u1EAFc v\xE0 Tr\u01B0ng Nh\u1ECB
    oai phong l\u1EABm li\u1EC7t, \u0111\u1EA7u \u0111\u1ED9i m\u0169 c\xE1nh ph\u01B0\u1EE3ng,
    tay r\xECu tay ki\u1EBFm d\u0169ng m\xE3nh c\u01B0\u1EE1i tr\xEAn hai th\u1EDBt
    voi chi\u1EBFn x\xF4ng th\u1EB3ng v\xE0o tr\u1EADn \u0111\u1ECBa \u0111\xE1nh
    \u0111u\u1ED5i qu\xE2n x\xE2m l\u01B0\u1EE3c nh\xE0 \u0110\xF4ng H\xE1n. T\xE1c
    ph\u1EA9m mang \xFD ngh\u0129a t\xF4n vinh tinh th\u1EA7n y\xEAu n\u01B0\u1EDBc
    qu\u1EADt kh\u1EDFi, \xFD ch\xED \u0111\u1ED9c l\u1EADp t\u1EF1 ch\u1EE7 t\u1EF1
    c\u01B0\u1EDDng v\xE0 s\u1EE9c m\u1EA1nh phi th\u01B0\u1EDDng c\u1EE7a ng\u01B0\u1EDDi
    ph\u1EE5 n\u1EEF Vi\u1EC7t Nam. D\xF9 l\xE0 tranh chi\u1EBFn tr\u1EADn nguy nga,
    n\xE9t v\u1EBD \u0110\xF4ng H\u1ED3 v\u1EABn gi\u1EEF \u0111\u01B0\u1EE3c v\u1EBB
    thanh cao, dung d\u1ECB c\u1EE7a hai v\u1ECB n\u1EEF v\u01B0\u01A1ng. Treo tranh
    trong nh\xE0 gi\xFAp k\xEDch ho\u1EA1t ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng ki\xEAn
    c\u01B0\u1EDDng, d\u0169ng c\u1EA3m, c\u1EE7ng c\u1ED1 uy v\u0169, \u0111\u1ECBa
    v\u1ECB cho gia ch\u1EE7 v\xE0 ch\u1EA5n h\u01B0ng v\u01B0\u1EE3ng kh\xED cho
    gia \u0111\xECnh."
  nguonGoc: "L\xE0 t\xE1c ph\u1EA9m kinh \u0111i\u1EC3n thu\u1ED9c nh\xF3m tranh
    l\u1ECBch s\u1EED c\u1EE7a d\xF2ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c
    in t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a
    l\xE0ng \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh, v\u1EDBi m\xE0u
    s\u1EAFc t\u1EF1 nhi\xEAn t\u1EEB c\xE1c nguy\xEAn li\u1EC7u d\xE2n gian tr\xEAn
    gi\u1EA5y d\xF3 qu\xE9t \u0111i\u1EC7p."
  moTa: "Tranh \u0110\xF4ng H\u1ED3 Hai B\xE0 Tr\u01B0ng \u0110\xE1nh Gi\u1EB7c \u0111\u01B0\u1EE3c
    l\u1EA5y c\u1EA3m h\u1EE9ng t\u1EEB 2 danh nh\xE2n \u0111\u1EA5t vi\u1EC7t l\xE0
    Hai B\xE0 Tr\u01B0ng, hai ch\u1ECB em anh h\xF9ng d\xE2n t\u1ED9c c\u1EE7a ng\u01B0\u1EDDi
    Vi\u1EC7t, l\xE0 t\xEAn g\u1ECDi chung c\u1EE7a hai b\xE0 Tr\u01B0ng Tr\u1EAFc
    v\xE0 Tr\u01B0ng Nh\u1ECB. M\u1EA5t v\xE0o ng\xE0y m\xF9ng 6 th\xE1ng 2 n\u0103m
    Qu\xFD M\xE3o 43, hai b\xE0 kh\u1EDFi binh ch\u1ED1ng l\u1EA1i qu\xE2n H\xE1n,
    l\u1EADp ra m\u1ED9t qu\u1ED1c gia c\xF3 kinh \u0111\xF4 t\u1EA1i M\xEA Linh
    v\xE0 t\u1EF1 phong l\xE0 n\u1EEF v\u01B0\u01A1ng. Tuy nhi\xEAn, cu\u1ED9c kh\u1EDFi
    ngh\u0129a n\xE0y \u0111\xE3 b\u1ECB qu\xE2n H\xE1n d\u01B0\u1EDBi s\u1EF1 ch\u1EC9
    huy c\u1EE7a M\xE3 Vi\u1EC7n \u0111\xE1nh b\u1EA1i, v\xE0 hai b\xE0 \u0111\xE3
    nh\u1EA3y xu\u1ED1ng s\xF4ng t\u1EF1 t\u1EED v\xEC kh\xF4ng mu\u1ED1n ch\u1ECBu
    khu\u1EA5t ph\u1EE5c."
  anhTranh: {fileID: 21300000, guid: 397d6f23375930a41899f54b1424a8fd, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: e07a71de68c4b5d4991823586834af04, type: 3}

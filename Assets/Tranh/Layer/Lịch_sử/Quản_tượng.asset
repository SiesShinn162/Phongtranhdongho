  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "Qu\u1EA3n_t\u01B0\u1EE3ng"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "Tranh d\xE2n gian \u0110\xF4ng H\u1ED3 Qu\u1EA3n T\u01B0\u1EE3ng"
  moTa: "B\u1EE9c tranh t\xF4n vinh s\u1EE9c m\u1EA1nh, s\u1EF1 d\u0169ng c\u1EA3m
    v\xE0 t\xE0i tr\xED c\u1EE7a con ng\u01B0\u1EDDi trong vi\u1EC7c chinh ph\u1EE5c,
    thu\u1EA7n h\xF3a lo\xE0i voi d\u1EEF. Trong v\u0103n h\xF3a Vi\u1EC7t Nam, h\xECnh
    \u1EA3nh con voi g\u1EAFn li\u1EC1n v\u1EDBi c\xE1c b\u1EADc anh h\xF9ng d\xE2n
    t\u1ED9c (nh\u01B0 Hai B\xE0 Tr\u01B0ng, B\xE0 Tri\u1EC7u, Quang Trung) v\xE0
    bi\u1EC3u th\u1ECB cho s\u1EF1 uy nghi\xEAm, may m\u1EAFn c\xF9ng l\u1EDDi ch\xFAc
    b\xECnh an, gia \u0111\xECnh v\u1EEFng ch\xE3i."
  anhTranh: {fileID: 21300000, guid: af29f5762097f2c448e0a53f6c20a320, type: 3}

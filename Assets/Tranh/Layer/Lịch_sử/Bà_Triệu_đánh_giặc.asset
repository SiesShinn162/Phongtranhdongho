  m_Script: {fileID: 11500000, guid: 341e9284c5098de498ebb2d1c546271c, type: 3}
  m_Name: "B\xE0_Tri\u1EC7u_\u0111\xE1nh_gi\u1EB7c"
  m_EditorClassIdentifier: Assembly-CSharp::PaintingData
  tenTranh: "B\xE0 Tri\u1EC7u \u0110\xE1nh Gi\u1EB7c"
  yNghia: "B\u1EE9c tranh kh\u1EAFc h\u1ECDa h\xECnh \u1EA3nh N\u1EEF v\u01B0\u01A1ng
    Tri\u1EC7u Th\u1ECB Trinh oai phong l\u1EABm li\u1EC7t, m\u1ED9t tay c\u1EA7m
    binh kh\xED, tay kia \u0111i\u1EC1u khi\u1EC3n ch\xFA voi tr\u1EAFng m\u1ED9t
    ng\xE0 d\u0169ng m\xE3nh x\xF4ng pha tr\u1EADn m\u1EA1c \u0111\u1EC3 \u0111\xE1nh
    \u0111u\u1ED5i qu\xE2n x\xE2m l\u01B0\u1EE3c \u0110\xF4ng Ng\xF4. T\xE1c ph\u1EA9m
    mang \xFD ngh\u0129a t\xF4n vinh l\xF2ng y\xEAu n\u01B0\u1EDBc n\u1ED3ng n\xE0n,
    \xFD ch\xED b\u1EA5t khu\u1EA5t v\xE0 tinh th\u1EA7n ki\xEAn c\u01B0\u1EDDng
    c\u1EE7a ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF Vi\u1EC7t Nam tr\u01B0\u1EDBc gi\u1EB7c
    ngo\u1EA1i x\xE2m. D\xF9 l\xE0 tranh chi\u1EBFn tr\u1EADn, n\xE9t v\u1EBD \u0110\xF4ng
    H\u1ED3 v\u1EABn kh\xE9o l\xE9o gi\u1EEF \u0111\u01B0\u1EE3c v\u1EBB \u0111\u1EB9p
    duy\xEAn d\xE1ng, n\u1EEF t\xEDnh c\u1EE7a v\u1ECB n\u1EEF t\u01B0\u1EDBng. Treo
    tranh trong nh\xE0 mang l\u1EA1i ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng c\u1EE7a
    s\u1EF1 d\u0169ng c\u1EA3m, quy\u1EBFt \u0111o\xE1n, gi\xFAp gia t\u0103ng uy
    v\u0169, quy\u1EC1n l\u1EF1c v\xE0 xua \u0111u\u1ED5i t\xE0 kh\xED."
  nguonGoc: "L\xE0 t\xE1c ph\u1EA9m ti\xEAu bi\u1EC3u thu\u1ED9c nh\xF3m tranh l\u1ECBch
    s\u1EED c\u1EE7a d\xF2ng tranh d\xE2n gian \u0110\xF4ng H\u1ED3, \u0111\u01B0\u1EE3c
    in t\u1EEB c\xE1c b\u1EA3n kh\u1EAFc g\u1ED7 truy\u1EC1n th\u1ED1ng c\u1EE7a
    l\xE0ng \u0110\xF4ng H\u1ED3, Thu\u1EADn Th\xE0nh, B\u1EAFc Ninh. Tranh s\u1EED
    d\u1EE5ng ho\xE0n to\xE0n m\xE0u s\u1EAFc t\u1EF1 nhi\xEAn tr\xEAn ch\u1EA5t
    li\u1EC7u gi\u1EA5y d\xF3 qu\xE9t \u0111i\u1EC7p truy\u1EC1n th\u1ED1ng."
  moTa: " B\u1EE9c tranh ca ng\u1EE3i cu\u1ED9c kh\u1EDFi ngh\u0129a c\u1EE7a v\u1ECB
    n\u1EEF anh h\xF9ng d\xE2n t\u1ED9c Tri\u1EC7u Th\u1ECB Trinh (B\xE0 Tri\u1EC7u)
    ch\u1ED1ng l\u1EA1i \xE1ch \u0111\xF4 h\u1ED9 t\xE0n b\u1EA1o c\u1EE7a nh\xE0
    Ng\xF4 v\xE0o n\u0103m 248."
  anhTranh: {fileID: 21300000, guid: 297297b134682a143a8e9ea86a09c358, type: 3}
  amThanhThuyetMinh: {fileID: 8300000, guid: e07a71de68c4b5d4991823586834af04, type: 3}

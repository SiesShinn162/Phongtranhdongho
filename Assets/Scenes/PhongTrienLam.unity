--- !u!114 &1356003069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1356003063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07ed411a0d6929d4ab723ef51d378e18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteract
  cacCauNoi:
  - "Ch\xE0o b\u1EA1n \u0111\u1EBFn v\u1EDBi l\xE0ng tranh \u0110\xF4ng H\u1ED3 qu\xEA
    t\xF4i!"
  - "Tranh \u1EDF \u0111\xE2y l\xE0m t\u1EEB gi\u1EA5y d\xF3, qu\xE9t \u0111i\u1EC7p
    \xF3ng \xE1nh l\u1EAFm \u0111\u1EA5y."
  - "B\u1EAFc Ninh m\xECnh kh\xF4ng ch\u1EC9 c\xF3 tranh \u0110\xF4ng H\u1ED3 \u0111\xE2u,
    c\xF2n l\xE0 qu\xEA h\u01B0\u01A1ng c\u1EE7a ngh\u1EC7 s\u0129 Xu\xE2n Hinh -
    'vua h\xE0i \u0111\u1EA5t B\u1EAFc' \u0111\u1EA5y."
  - "B\u1EA1n c\xF3 bi\u1EBFt ca kh\xFAc 'B\u1EAFc Bling' kh\xF4ng? \u0110\xF3 l\xE0
    c\u1EE7a Ho\xE0 Minzy, c\xF4 \u1EA5y c\u0169ng l\xE0 ng\u01B0\u1EDDi B\u1EAFc
    Ninh, qu\xEA \u1EDF Qu\u1EBF V\xF5."
  - "MV B\u1EAFc Bling quay ngay t\u1EA1i l\xE0ng qu\xEA B\u1EAFc Ninh m\xECnh, c\xF3
    c\u1EA3 ngh\u1EC7 s\u0129 Xu\xE2n Hinh g\xF3p gi\u1ECDng rap, vui l\u1EAFm."
  - "M\u1ED7i b\u1EE9c tranh \u1EDF \u0111\xE2y \u0111\u1EC1u mang 1 c\xE2u chuy\u1EC7n
    d\xE2n gian ri\xEAng, b\u1EA1n th\u1EED ng\u1EAFm k\u1EF9 xem nh\xE9."
  khoangCachToiDa: 3
  layerNPC:
    serializedVersion: 2
    m_Bits: 0
